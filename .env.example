# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен бота от @BotFather. Никогда не хардкодить и не логировать!
BOT_TOKEN=

# Прокси для Telegram API (HTTP(S) или SOCKS):
# http://user:pass@host:port, socks5://host:port. Пусто = без прокси.
# Может содержать пароль — не коммитить и не логировать.
BOT_PROXY=

# Ссылка на страницу поддержки. Пусто = кнопка «Поддержать» скрыта.
SUPPORT_URL=

# Контакт автора (например @username). Пусто = кнопка «Написать автору» скрыта.
AUTHOR_CONTACT=

# Ссылка на сообщество бота в Telegram (группа с темами). Пусто = кнопка
# «Наше сообщество» на экране «О боте» скрыта.
GROUP_URL=

# Путь к файлу SQLite.
DB_PATH=data/bot.sqlite3

# Часовой пояс по умолчанию (IANA), если пользователь пропустил выбор.
DEFAULT_TIMEZONE=Europe/Minsk

# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Секрет для подписи сессий и magic link личного кабинета (itsdangerous).
WEB_SECRET_KEY=

# Base URL личного кабинета (https://…). Пусто = кабинет не развёрнут, /cabinet
# отвечает «Личный кабинет пока не развёрнут».
CABINET_URL=

# Telegram ID администраторов через запятую (команда /admin, SPEC.md §18).
# Пусто = админ-панель отключена.
ADMIN_TELEGRAM_IDS=

# ─── Бэкапы (SPEC.md §20) ───────────────────────────────────────────────

# Ключ шифрования бэкапов (AES-GCM). Любая секретная строка, например
# результат `openssl rand -base64 32`. Без неё бэкап не создаётся.
# Храните копию ключа отдельно: без него зашифрованные бэкапы не расшифровать.
# Не коммитить!
BACKUP_ENCRYPTION_KEY=

# Каталог локальных зашифрованных копий (внутри тома — /app/data/backups).
BACKUP_DIR=data/backups

# Журнал удалений (SPEC.md §19): метка удалённого аккаунта (HMAC) + дата, чтобы
# после восстановления копии удалить аккаунты снова. Ключ обязателен, если задан
# BACKUP_ENCRYPTION_KEY: `openssl rand -base64 32`. Не коммитить!
DELETION_LOG_KEY=
# Файл журнала — вне файла БД и BACKUP_DIR (восстановление копии его не трогает).
DELETION_LOG_PATH=data/deletions.log

# Off-site отправка копий в S3-совместимое хранилище (SPEC.md §20).
# Всё пусто = off-site выключен, копии остаются только локально.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Письма врачу со ссылкой доступа (SPEC.md §21). SMTP своего домена.
# SMTP_HOST пуст = письма не отправляются, ссылка — пациенту для пересылки.
SMTP_HOST=
# 465 — SSL, 587 — STARTTLS (SMTP_SECURITY=starttls).
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
# Не коммитить!
SMTP_PASSWORD=
# Отправитель, например: Дневник гипертоника <noreply@electroman.by>
SMTP_FROM=

# Страница «Персональные данные» (SPEC.md §3, §16.1): ссылки из экранов согласия.
# Пустое значение — ошибка при старте.
PRIVACY_URL=https://bp-diary.electroman.by/privacy.html

# ─── QA-стенд (SPEC.md §22, Telethon/Playwright) ────────────────────────

# API ID и API Hash для Telethon — получить на my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Номер телефона тестового аккаунта в международном формате (+375…).
TELEGRAM_TEST_PHONE=

# Опционально: сохранённая сессия Telethon (StringSession) — чтобы не
# проходить код подтверждения при каждом запуске QA.
TELETHON_SESSION=

# Username тестируемого бота, например @my_bp_diary_bot.
QA_BOT_USERNAME=
