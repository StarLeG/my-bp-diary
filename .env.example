# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен бота от @BotFather. Никогда не хардкодить и не логировать!
BOT_TOKEN=

# Ссылка на страницу поддержки. Пусто = кнопка «Поддержать» скрыта.
SUPPORT_URL=

# Контакт автора (например @username). Пусто = кнопка «Написать автору» скрыта.
AUTHOR_CONTACT=

# Путь к файлу SQLite.
DB_PATH=data/bot.sqlite3

# Часовой пояс по умолчанию (IANA), если пользователь пропустил выбор.
DEFAULT_TIMEZONE=Europe/Minsk

# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Секрет для подписи сессий и magic link личного кабинета (itsdangerous).
WEB_SECRET_KEY=

# Base URL личного кабинета (https://…). Пусто = кабинет не развёрнут, /cabinet
# отвечает «Личный кабинет пока не развёрнут».
CABINET_URL=
